
# ==========================================
# Application Configuration
# ==========================================
APP_ENV=development
LOG_LEVEL=DEBUG

# ==========================================
# Service Ports
# ==========================================
ORDER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8083
API_GATEWAY_PORT=8080

# ==========================================
# PostgreSQL Configuration
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=test
DB_SSLMODE=disable

# Separate database for each service
ORDER_DB_NAME=order_db
PRODUCT_DB_NAME=product_db
AUTH_DB_NAME=auth_db

# ==========================================
# Consul Configuration (Local Development)
# ==========================================
CONSUL_ADDRESS=127.0.0.1:8500
CONSUL_SCHEME=http
CONSUL_DATACENTER=dc1

# ==========================================
# Service URLs (Local Development)
# ==========================================
ORDER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
AUTH_SERVICE_URL=http://localhost:8083

# ==========================================
# HTTP Client Configuration
# ==========================================
HTTP_CLIENT_TIMEOUT_SECONDS=5
HTTP_CLIENT_MAX_RETRIES=3

# ==========================================
# Circuit Breaker Configuration
# ==========================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# ==========================================
# Authentication Configuration
# ==========================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MINUTES=60

# ==========================================
# AWS Production Configuration
# Configure real values securely in AWS.
# Do not commit production secrets to GitHub.
# ==========================================
AWS_REGION=eu-north-1
AWS_SECRETS_MANAGER_SECRET_NAME=order-management/production
