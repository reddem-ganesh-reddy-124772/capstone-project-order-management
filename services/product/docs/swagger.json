{
    "swagger": "2.0",
    "info": {
        "description": "REST and GraphQL APIs for managing products.",
        "title": "Product Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8082",
    "basePath": "/",
    "paths": {
        "/api/inventory/reservations": {
            "get": {
                "description": "Retrieves all inventory reservation records.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Inventory Reservations"
                ],
                "summary": "Get all inventory reservations",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.InventoryReservation"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to retrieve reservations",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Reserves a specified quantity of an existing product.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Inventory Reservations"
                ],
                "summary": "Reserve product stock",
                "parameters": [
                    {
                        "description": "Stock reservation details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.ReserveStockRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Stock reserved successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Invalid request or reservation error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/inventory/reservations/release": {
            "post": {
                "description": "Releases stock associated with an existing reservation.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Inventory Reservations"
                ],
                "summary": "Release reserved stock",
                "parameters": [
                    {
                        "description": "Reservation to release",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controller.ReleaseStockRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Stock released successfully",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request or release error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/inventory/reservations/{reservation_id}": {
            "get": {
                "description": "Retrieves a reservation using its reservation ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Inventory Reservations"
                ],
                "summary": "Get a stock reservation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Reservation ID",
                        "name": "reservation_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.InventoryReservation"
                        }
                    },
                    "400": {
                        "description": "Reservation ID is required",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Reservation not found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/products": {
            "get": {
                "description": "Lists products with optional filters, sorting, and pagination. Parameters can be combined.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "List products",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Records per page (default 10, maximum 100)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Filter by product name",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Minimum price",
                        "name": "min_price",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Maximum price",
                        "name": "max_price",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "Filter by stock availability",
                        "name": "in_stock",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort field: id, name, price, stock, created_at, updated_at",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Sort direction: asc or desc",
                        "name": "sort_order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ProductListResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a product after validating its details.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Create a product",
                "parameters": [
                    {
                        "description": "Product details",
                        "name": "product",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.CreateProductRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/dto.ProductResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/api/products/{id}": {
            "get": {
                "description": "Returns the details of a product.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Get a product by ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Product ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ProductResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "put": {
                "description": "Updates the details of an existing product.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Update a product",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Product ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated product details",
                        "name": "product",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/dto.UpdateProductRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/dto.ProductResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "delete": {
                "description": "Deletes an existing product.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Products"
                ],
                "summary": "Delete a product",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Product ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controller.ReleaseStockRequest": {
            "type": "object",
            "required": [
                "reservation_id"
            ],
            "properties": {
                "reservation_id": {
                    "type": "string"
                }
            }
        },
        "controller.ReserveStockRequest": {
            "type": "object",
            "required": [
                "product_id",
                "quantity",
                "reservation_id"
            ],
            "properties": {
                "product_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "reservation_id": {
                    "type": "string"
                }
            }
        },
        "dto.CreateProductRequest": {
            "type": "object",
            "required": [
                "name",
                "price"
            ],
            "properties": {
                "description": {
                    "description": "Description provides additional information about the product.",
                    "type": "string"
                },
                "name": {
                    "description": "Name is the name of the product.",
                    "type": "string",
                    "maxLength": 150
                },
                "price": {
                    "description": "Price is the product's selling price and must be greater than zero.",
                    "type": "number"
                },
                "stock": {
                    "description": "Stock is the available quantity and cannot be negative.",
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "dto.ProductListResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "description": "Items contains the products on the current page.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.ProductResponse"
                    }
                },
                "limit": {
                    "description": "Limit is the maximum number of products per page.",
                    "type": "integer"
                },
                "page": {
                    "description": "Page is the current page number.",
                    "type": "integer"
                },
                "total_pages": {
                    "description": "TotalPages is the number of pages available for the matching products.",
                    "type": "integer"
                },
                "total_records": {
                    "description": "TotalRecords is the number of products matching the filters.",
                    "type": "integer"
                }
            }
        },
        "dto.ProductResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "CreatedAt records when the product was created.",
                    "type": "string"
                },
                "description": {
                    "description": "Description explains the product.",
                    "type": "string"
                },
                "id": {
                    "description": "ID is the unique product identifier.",
                    "type": "integer"
                },
                "name": {
                    "description": "Name is the product name.",
                    "type": "string"
                },
                "price": {
                    "description": "Price is the product's selling price.",
                    "type": "number"
                },
                "stock": {
                    "description": "Stock is the available quantity.",
                    "type": "integer"
                },
                "updated_at": {
                    "description": "UpdatedAt records when the product was last updated.",
                    "type": "string"
                }
            }
        },
        "dto.UpdateProductRequest": {
            "type": "object",
            "required": [
                "name",
                "price"
            ],
            "properties": {
                "description": {
                    "description": "Description is the updated product description.",
                    "type": "string"
                },
                "name": {
                    "description": "Name is the updated product name.",
                    "type": "string",
                    "maxLength": 150
                },
                "price": {
                    "description": "Price is the updated selling price and must be greater than zero.",
                    "type": "number"
                },
                "stock": {
                    "description": "Stock is the updated available quantity and cannot be negative.",
                    "type": "integer",
                    "minimum": 0
                }
            }
        },
        "model.InventoryReservation": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "CreatedAt records when this reservation was created.",
                    "type": "string"
                },
                "id": {
                    "description": "ID is the database-generated primary key.",
                    "type": "integer"
                },
                "product_id": {
                    "description": "ProductID identifies the product whose stock is reserved.",
                    "type": "integer"
                },
                "quantity": {
                    "description": "Quantity is the number of units reserved.",
                    "type": "integer"
                },
                "reservation_id": {
                    "description": "ReservationID uniquely identifies this reservation.\nRetried requests must reuse the same ID.",
                    "type": "string"
                },
                "status": {
                    "description": "Status records whether stock is currently reserved or released.\nAllowed values are reserved and released.",
                    "type": "string"
                },
                "updated_at": {
                    "description": "UpdatedAt records when this reservation was last updated.",
                    "type": "string"
                }
            }
        }
    }
}